; Flow rate / max volumetric speed benchmark (CNC Kitchen pile method)
; Generated by tools/generate_flow_rate_test.py with:
; --out flow_test_PETG_nonHF_0.4mm.gcode --dialect single --tool 0 --temp 245 --bed-temp 80 --flow-start 6 --flow-step 3 --flow-count 15 --pile-length 500 --bed-x 250 --bed-y 210 --margin 30 --spacing 20
; tool=0 temp=245.0C bed=80.0C
; flow: start=6.0 step=3.0 count=15 mm3/s, pile_length=500.0mm

M17 ; enable steppers
G90 ; absolute positioning
M83 ; relative extruder mode
G28 ; home all axes
M140 S80.0 ; set bed temp
M104 S245.0 T0 ; set nozzle temp
M190 S80.0 ; wait for bed temp
M109 S245.0 T0 ; wait for nozzle temp
G29 P1 ; invalidate & probe mesh
G29 P3.2 ; interpolate mesh
G29 P3.13 ; extrapolate mesh outside probed area
G29 A ; activate mesh bed leveling
G1 Z5 F600

; --- pile 1/15: 6.0 mm3/s (F150) ---
G1 X30.0 Y30.0 F6000
G1 Z0.3 F600
G1 E20 F300 ; prime
G4 S2

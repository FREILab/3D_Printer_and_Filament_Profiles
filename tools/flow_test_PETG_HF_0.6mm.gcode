; tool=0 temp=240.0C (bed unheated, no mesh leveling)
; flow: start=6.0 step=3.0 count=15 mm3/s, pile_length=500.0mm

M17 ; enable steppers
G90 ; absolute positioning
M83 ; relative extruder mode
G28 XY ; home XY
T0 S1 L0 D0 ; pick tool
G28 Z ; home Z
M104 S240.0 T0 ; set nozzle temp
M109 S240.0 T0 ; wait for nozzle temp
G1 Z5 F600


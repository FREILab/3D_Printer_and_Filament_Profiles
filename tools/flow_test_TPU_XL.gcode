; Flow rate / max volumetric speed benchmark (CNC Kitchen pile method)
; Generated by tools/generate_flow_rate_test.py with:
; --out flow_test_TPU_XL.gcode --dialect xl --tool 0 --temp 230 --bed-temp 0 --flow-start 0.75 --flow-step 0.25 --flow-count 8 --pile-length 100
; tool=0 temp=230.0C bed=0.0C
; flow: start=0.75 step=0.25 count=8 mm3/s, pile_length=100.0mm

M17 ; enable steppers
G90 ; absolute positioning
M83 ; relative extruder mode
G28 XY ; home XY
T0 S1 L0 D0 ; pick tool
G28 Z ; home Z
M140 S0.0 ; set bed temp
M104 S230.0 T0 ; set nozzle temp
M190 S0.0 ; wait for bed temp
M109 S230.0 T0 ; wait for nozzle temp
G29 P1 ; invalidate & probe mesh
G29 P3.2 ; interpolate mesh
G29 P3.13 ; extrapolate mesh outside probed area
G29 A ; activate mesh bed leveling
G1 Z5 F600

; --- pile 1/8: 0.8 mm3/s (F19) ---
G1 X40.0 Y40.0 F6000
G1 Z0.3 F600
G1 E20 F300 ; prime
G4 S2
M117 Pile 1/8 0.8mm3s: remove string, press knob
M0
G1 E100.0 F19 ; sustained extrusion at target flow
G1 E-2 F1800 ; retract
G1 Z5 F600


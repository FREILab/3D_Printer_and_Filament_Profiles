; --out flow_test_PETG_MK3.gcode --dialect legacy --tool 0 --temp 240 --flow-start 6 --flow-step 3 --flow-count 15 --pile-length 1500 --bed-x 250 --bed-y 210 --margin 30 --spacing 25
; tool=0 temp=240.0C (bed unheated, no mesh leveling)
; flow: start=6.0 step=3.0 count=15 mm3/s, pile_length=1500.0mm

M17 ; enable steppers
G90 ; absolute positioning
M83 ; relative extruder mode
M104 S240.0 ; set extruder temp
M109 S240.0 ; wait for extruder temp
G28 W ; home, explicitly skip automatic mesh probe
G1 Z5 F600

